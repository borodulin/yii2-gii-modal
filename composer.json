{
    "name": "conquer/gii-modal",
    "description": "Gii CRUD generator for Yii2 with view, create and update pages in a Bootstrap 3/4/5 modal",
    "keywords": [
        "yii2",
        "extension",
        "gii",
        "crud",
        "modal",
        "bootstrap"
    ],
    "homepage": "https://github.com/borodulin/yii2-gii-modal",
    "type": "yii2-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com",
            "homepage": "https://github.com/borodulin/yii2-gii-modal"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "1.3.x-dev"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "yiisoft/yii2": "~2.0.14",
        "yiisoft/yii2-gii": "~2.0"
    },
    "suggest": {
        "yiisoft/yii2-bootstrap5": "Bootstrap 5 modal (one of the Yii Bootstrap extensions is required)",
        "yiisoft/yii2-bootstrap4": "Bootstrap 4 modal",
        "yiisoft/yii2-bootstrap": "Bootstrap 3 modal"
    },
    "autoload": {
        "psr-4": {
            "conquer\\gii\\": ""
        }
    }
}
